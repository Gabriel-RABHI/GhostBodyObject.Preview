<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tutorials.T004</RootNamespace>
    <!-- The code that GBO writes for a model reads the objects in memory through pointers: a project with a model allows
         unsafe code. Without it, the build stops on the error GBO008. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
	  <PackageReference Include="System.IO.Hashing" Version="10.0.0.6" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

	<ItemGroup>
		<!-- Load the source generator in the compiler so it generates the model at build time. -->
		<Analyzer Include="..\Libs\GhostBodyObject.Generator.dll" />
		<Reference Include="GhostBodyObject.Runtime">
			<HintPath>..\Libs\GhostBodyObject.Runtime.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
